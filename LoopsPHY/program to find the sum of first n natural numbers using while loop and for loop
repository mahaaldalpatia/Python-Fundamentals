Write a program to find the sum of first n natural numbers using while loop.
n = int(input("Num:"))
i=1
sum = 0
#while loop
while i<=n :
    sum = sum + i 
    
    i += 1
    print("sum = ", sum)

#for loop
sum = 0 
n = int(input("Num:"))

for i in range(1, n-1):
    sum = sum + i

print("Sum of numbers from 1 to 100 =", sum)
